# ==============================================================================
# SoodFolio Backend - Production Environment Template (Render / Railway / Cloud)
# Copy this file to .env or configure these variables in Render/Railway dashboard.
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL.
# ==============================================================================

# Spring Profile & Server Port
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Neon PostgreSQL Database (Pooled Connection for Runtime)
# Format: jdbc:postgresql://ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_URL=jdbc:postgresql://ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password

# Flyway Database Migration (Direct Connection - No Pooler)
# Neon requires direct connection (without -pooler) for schema migrations/locks
FLYWAY_DB_URL=jdbc:postgresql://ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
# Generate a secure 256-bit+ secret key: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRATION_MS=900000

# CORS & Domain Configuration
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
FRONTEND_BASE_URL=https://your-frontend.vercel.app
COOKIE_SECURE=true

# OAuth2 Authentication
OAUTH_SANDBOX_ENABLED=false
OAUTH_ALLOWED_REDIRECT_URIS=https://your-frontend.vercel.app/auth/callback/github,https://your-frontend.vercel.app/auth/callback/google
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Cloudinary File Storage (Images & PDF CVs)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Brevo (Sendinblue) Transactional Email
MAIL_PROVIDER=brevo
BREVO_API_KEY=your_brevo_api_key
MAIL_SENDER_EMAIL=noreply@yourdomain.com
MAIL_SENDER_NAME=SoodFolio

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key
