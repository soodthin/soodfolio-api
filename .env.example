# ==============================================================================
# SoodFolio Backend Environment Variables Template
# Copy this file to .env before starting Spring Boot locally
# ==============================================================================

SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soodfolio_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Secret (Base64 string >= 256 bits)
JWT_SECRET=your_base64_jwt_secret_here
JWT_EXPIRATION_MS=1800000

# OAuth2 Provider Credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
APP_OAUTH2_SANDBOX_ENABLED=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gemini AI Service
GEMINI_API_KEY=

# Cloudinary Storage
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

