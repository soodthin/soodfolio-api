SPRING_PROFILES_ACTIVE=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=soodfolio_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Secret (Base64 string >= 256 bits)
JWT_SECRET=your_base64_jwt_secret_here
JWT_EXPIRATION_MS=1800000

# OAuth2 Provider Credentials
GITHUB_CLIENT_ID=Ov23li3aBSxR9V3u8J2O
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GOOGLE_CLIENT_ID=622903719114-lilk7gbj5jcc138eva810gvr7uva3fqe.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
APP_OAUTH2_SANDBOX_ENABLED=true

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

